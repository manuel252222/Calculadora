import pandas as pd

def calculate_demographic_data():

    df = pd.read_csv(
        "adult.data.csv",
        names=[
            "age",
            "workclass",
            "fnlwgt",
            "education",
            "education-num",
            "marital-status",
            "occupation",
            "relationship",
            "race",
            "sex",
            "capital-gain",
            "capital-loss",
            "hours-per-week",
            "native-country",
            "salary"
        ],
        skipinitialspace=True
    )

    race_count = df["race"].value_counts()

    return race_count
